<% content_for :title, "Edit comment" %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <h1 class="h4 mb-3">Edit comment on “<%= @post.title %>”</h1>
    <%= render "form", post: @post, comment: @comment %>
    <%= link_to "Back to post", @post, class: "btn btn-link mt-2" %>
  </div>
</div>
