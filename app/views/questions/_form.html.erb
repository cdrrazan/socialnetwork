<%= simple_form_for question do |f| %>
  <%= f.error_notification %>
  <%= f.input :title, placeholder: "What's your programming question? Be specific." %>
  <%= f.input :body, label: "Details", input_html: { rows: 8 },
                     hint: "Include what you tried and what you expected to happen." %>
  <div class="d-flex gap-2">
    <%= f.button :submit, question.persisted? ? "Update question" : "Ask question", class: "btn-primary" %>
    <%= link_to "Cancel", question.persisted? ? question : questions_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
