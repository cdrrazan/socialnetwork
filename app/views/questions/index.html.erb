<% content_for :title, "Forum" %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
  <div>
    <h1 class="h3 mb-0">Forum</h1>
    <p class="text-body-secondary mb-0">Have a look at existing questions before asking a new one.</p>
  </div>
  <%= link_to "Ask a question", new_question_path, class: "btn btn-primary" %>
</div>

<% if @questions.any? %>
  <div class="list-group">
    <% @questions.each do |question| %>
      <%= link_to question, class: "list-group-item list-group-item-action", id: dom_id(question) do %>
        <div class="d-flex justify-content-between">
          <strong><%= question.title %></strong>
          <small class="text-body-secondary"><%= time_ago_in_words(question.created_at) %> ago</small>
        </div>
        <small class="text-body-secondary">
          asked by <%= question.user.display_name %> · <%= pluralize(question.answers_count, "answer") %>
        </small>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="text-center text-body-secondary py-5">No questions yet.</p>
<% end %>
