<% content_for :title, "Blog" %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
  <div>
    <h1 class="h3 mb-0">Blog</h1>
    <% if params[:tag].present? %>
      <p class="text-body-secondary mb-0">
        Posts tagged <strong><%= params[:tag] %></strong> · <%= link_to "show all", posts_path %>
      </p>
    <% end %>
  </div>
  <%= link_to "Write a post", new_post_path, class: "btn btn-primary" %>
</div>

<% if @posts.any? %>
  <%= render @posts %>
<% else %>
  <div class="text-center text-body-secondary py-5">
    <p>No posts yet. Why not write the first one?</p>
  </div>
<% end %>
