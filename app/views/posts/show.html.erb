<% content_for :title, @post.title %>

<div class="row g-4">
  <article class="col-lg-8">
    <h1 class="h2"><%= @post.title %></h1>
    <p class="text-body-secondary">
      by <%= link_to @post.user.display_name, @post.user %> · <%= l(@post.created_at.to_date, format: :long) %>
    </p>
    <%= render "posts/tags", post: @post %>

    <div class="post-body my-4">
      <%= sanitize @post.body %>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
      <%= button_to like_post_path(@post), method: :put, class: "btn btn-outline-success btn-sm" do %>
        👍 <span class="ms-1"><%= @post.cached_votes_up %></span>
      <% end %>
      <%= button_to dislike_post_path(@post), method: :put, class: "btn btn-outline-danger btn-sm" do %>
        👎 <span class="ms-1"><%= @post.cached_votes_down %></span>
      <% end %>

      <div class="ms-auto d-flex gap-2">
        <% if policy(@post).update? %>
          <%= link_to "Edit", edit_post_path(@post), class: "btn btn-outline-secondary btn-sm" %>
        <% end %>
        <% if policy(@post).destroy? %>
          <%= button_to "Delete", @post, method: :delete, class: "btn btn-outline-danger btn-sm",
                                          form: { data: { turbo_confirm: "Delete this post?" } } %>
        <% end %>
      </div>
    </div>

    <section id="comments">
      <h2 class="h5">Comments (<%= @comments.size %>)</h2>
      <%= render partial: "comments/comment", collection: @comments, locals: { post: @post } %>
      <%= render "comments/form", post: @post, comment: @comment %>
    </section>
  </article>

  <aside class="col-lg-4">
    <div class="card">
      <div class="card-header">Similar posts</div>
      <% if @similar_posts.any? %>
        <ul class="list-group list-group-flush">
          <% @similar_posts.each do |similar_post| %>
            <li class="list-group-item"><%= link_to similar_post.title, similar_post %></li>
          <% end %>
        </ul>
      <% else %>
        <div class="card-body text-body-secondary small">No similar posts yet.</div>
      <% end %>
    </div>
  </aside>
</div>
