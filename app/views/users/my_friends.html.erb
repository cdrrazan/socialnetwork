<% content_for :title, "Friends" %>

<div class="row g-4">
  <section class="col-md-6">
    <h1 class="h4">Following (<%= @following.size %>)</h1>
    <% if @following.any? %>
      <div class="list-group">
        <% @following.each do |user| %>
          <%= render "users/user", user: user, following: true %>
        <% end %>
      </div>
    <% else %>
      <p class="text-body-secondary">You aren't following anyone yet. <%= link_to "Find people", users_path %>.</p>
    <% end %>
  </section>

  <section class="col-md-6">
    <h2 class="h4">Followers (<%= @followers.size %>)</h2>
    <% if @followers.any? %>
      <div class="list-group">
        <% @followers.each do |user| %>
          <div class="list-group-item d-flex align-items-center gap-3">
            <%= render "users/avatar", user: user, size: 40 %>
            <%= link_to user.display_name, user %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-body-secondary">No followers yet.</p>
    <% end %>
  </section>
</div>
