<%# locals: (user:, following: false) -%>
<div class="list-group-item d-flex align-items-center gap-3" id="<%= dom_id(user) %>">
  <%= render "users/avatar", user: user, size: 40 %>
  <div class="me-auto">
    <%= link_to user.display_name, user, class: "fw-semibold" %>
  </div>
  <%= link_to "Message", new_personal_message_path(receiver_id: user.id), class: "btn btn-outline-secondary btn-sm" %>
  <%= render "users/follow_button", user: user, following: following %>
</div>
