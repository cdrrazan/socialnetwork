<% other = @conversation.with(current_user) %>
<% content_for :title, "Conversation with #{other.display_name}" %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <h1 class="h4 mb-3">Conversation with <%= link_to other.display_name, other %></h1>

    <div class="conversation-body card card-body mb-3" data-controller="scroll-bottom">
      <%= render @conversation.personal_messages.includes(:user) %>
    </div>

    <%= simple_form_for @personal_message do |f| %>
      <%= hidden_field_tag :conversation_id, @conversation.id %>
      <%= f.input :body, as: :text, label: false, placeholder: "Write a reply…", input_html: { rows: 3 } %>
      <%= f.button :submit, "Reply", class: "btn-primary" %>
    <% end %>

    <%= link_to "All conversations", conversations_path, class: "btn btn-link mt-2 px-0" %>
  </div>
</div>
