<% content_for :title, "My profile" %>

<div class="d-flex flex-wrap align-items-center gap-3 mb-4">
  <%= render "users/avatar", user: current_user, size: 96 %>
  <div class="me-auto">
    <h1 class="h3 mb-1"><%= current_user.display_name %></h1>
    <div class="text-body-secondary small">
      <%= link_to pluralize(@followers.size, "follower"), my_friends_path %> ·
      <%= link_to "#{@following.size} following", my_friends_path %>
    </div>
  </div>
  <%= link_to "Edit profile", edit_user_registration_path, class: "btn btn-outline-secondary btn-sm" %>
</div>

<div class="row g-4">
  <section class="col-lg-7">
    <h2 class="h5">My posts</h2>
    <% if @posts.any? %>
      <%= render @posts %>
    <% else %>
      <p class="text-body-secondary">You haven't written anything yet. <%= link_to "Write a post", new_post_path %>.</p>
    <% end %>
  </section>

  <section class="col-lg-5">
    <h2 class="h5">My questions</h2>
    <% if @questions.any? %>
      <div class="list-group">
        <% @questions.each do |question| %>
          <%= link_to question.title, question, class: "list-group-item list-group-item-action" %>
        <% end %>
      </div>
    <% else %>
      <p class="text-body-secondary">No questions yet. <%= link_to "Ask one", new_question_path %>.</p>
    <% end %>
  </section>
</div>
