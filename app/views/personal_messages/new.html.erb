<% content_for :title, "New message" %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <h1 class="h4 mb-3">New message to <%= @receiver.display_name %></h1>
    <%= simple_form_for @personal_message do |f| %>
      <%= hidden_field_tag :receiver_id, @receiver.id %>
      <%= f.input :body, as: :text, label: "Message", input_html: { rows: 4 } %>
      <%= f.button :submit, "Send", class: "btn-primary" %>
    <% end %>
  </div>
</div>
