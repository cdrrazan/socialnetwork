# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# only read in development and test (via dotenv-rails).

# --- MySQL (defaults shown; see config/database.yml) ---
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=socialnetwork
# DB_PASSWORD=socialnetwork
# Or a full URL, which takes precedence for the primary database:
# DATABASE_URL=mysql2://user:password@127.0.0.1:3306/socialnetwork_development

# --- Google reCAPTCHA v2 for new posts (https://www.google.com/recaptcha/admin) ---
# Leave empty to switch reCAPTCHA off.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Email ---
# Sender for password resets and other mail. Defaults to
# "DevStory <no-reply@APP_HOST>".
# MAILER_FROM="DevStory <hello@example.com>"

# --- System specs ---
# Chrome/Chromium binary for Cuprite, if it isn't on your PATH.
# BROWSER_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Set to false to watch the browser while system specs run.
# HEADLESS=false
